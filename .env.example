# --- Required ---

# Create a Twitch app at https://dev.twitch.tv/console/apps
# (any OAuth Redirect URL works, e.g. http://localhost, since this script
# only uses the app/client-credentials flow, not user login)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Discord: Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXXXXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Optional ---

# Exact Twitch category name to track (defaults to Just Shapes & Beats)
TWITCH_GAME_NAME=Just Shapes & Beats

# How often to poll the Twitch API, in seconds
POLL_INTERVAL_SECONDS=60

# How many seconds a streamer can vanish from the live list before being
# treated as offline (defaults to 2x the poll interval + 30s)
OFFLINE_GRACE_SECONDS=150

# Notify for streamers who are already live when the bot first starts
NOTIFY_ON_FIRST_RUN=false

# Text to prepend to notifications, e.g. @everyone or a role mention
DISCORD_MENTION=

# Where to persist "who's currently live" between restarts
STATE_FILE=jsab_tracker_state.json

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

